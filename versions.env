# Versions for the whole delivery chain. Every tool, chart and image used by
# this project is pinned here, with the sha256 of each downloaded binary.
# Source of truth: scripts/install-tools.sh (local) and .github/workflows (CI).
# Last verified against upstream: 2026-11-01

# ---------------------------------------------------------------- cluster ----
KIND_VERSION=v0.33.0
KIND_NODE_IMAGE=kindest/node:v1.34.11
KUBECTL_VERSION=v1.34.11

# ------------------------------------------------------------- local tools ---
HELM_VERSION=v4.3.1
KUSTOMIZE_VERSION=v5.8.3
ARGOCD_VERSION=v3.5.6
ARGO_ROLLOUTS_VERSION=v1.10.1
GH_VERSION=v2.103.3

KIND_SHA256=4b22adaa135368c5a465d56bbd8e520cbea87272a06ca00b6078e7b81515c9fc
KUBECTL_SHA256=8e352ca98d4cbba570731b0254705f88ef11dc0fd831d845e8b5bd21003bd778
HELM_SHA256=fcfd7b796dcf0f225abc40b5636a3b01f55f3de2fb1dfb18475df94e62c14112
KUSTOMIZE_SHA256=763c4040ff01435bfce39661072452ebdf1cf2808bb91f5708ab4420834fbd42
ARGO_ROLLOUTS_SHA256=ad8da0c9f1e9a67292c0019a906ef7e54157d598df90fa0b59839bc039a624b7
GH_SHA256=98d0cfa794721665d7973dd728c78aff7bd836d58f10f6d7a03568eccb0a22e0

# Naming convention: FOO_SHA256 is the Windows build that
# scripts/install-tools.sh installs locally; FOO_SHA256_LINUX is what CI,
# which runs on ubuntu-24.04, verifies instead. Both come from the upstream
# release metadata, not from a re-download.
#
# Installed by CI only. ci.yml checks this repo out, sources this file and
# installs Trivy at exactly this version, so a tool version is declared once
# for the whole chain.
TRIVY_VERSION=v0.76.1
TRIVY_SHA256_LINUX=c7cbe3137fb8a48a17574bede3dd6beb16742d1e9772929940fc90082c39d9c0

# CI also needs kustomize, to rewrite the image tag in the overlay.
KUSTOMIZE_SHA256_LINUX=cb9e31198d3f63b44848bd0afc4c8efc56e6cfef9c93a4a39a211940e6decd61

# ---------------------------------------------------------------- app image --
# Tag plus digest: readable in logs, immutable in practice.
PYTHON_BASE_IMAGE=python:3.12-slim-bookworm@sha256:e697c81897302a4c4333bade000d98038fbb21eb064f8ee1fd42d02ebcd9d337
