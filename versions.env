# Versions for the whole delivery chain. Every tool, chart and image used by
# this project is pinned here, with the sha256 of each downloaded binary and
# install manifest.
# Source of truth: scripts/install-tools.sh + scripts/bootstrap.sh (local) and
# .github/workflows/ci.yml (CI), which all source this file instead of repeating
# a version.
# Last verified against upstream: 2026-11-02

# ---------------------------------------------------------------- cluster ----
KIND_VERSION=v0.33.0
KIND_NODE_IMAGE=kindest/node:v1.34.11
KUBECTL_VERSION=v1.34.11

# ------------------------------------------------------------- local tools ---
HELM_VERSION=v4.3.1
KUSTOMIZE_VERSION=v5.8.3
ARGOCD_VERSION=v3.5.6
ARGO_ROLLOUTS_VERSION=v1.10.1
GH_VERSION=v2.103.3

KIND_SHA256=4b22adaa135368c5a465d56bbd8e520cbea87272a06ca00b6078e7b81515c9fc
KUBECTL_SHA256=8e352ca98d4cbba570731b0254705f88ef11dc0fd831d845e8b5bd21003bd778
HELM_SHA256=fcfd7b796dcf0f225abc40b5636a3b01f55f3de2fb1dfb18475df94e62c14112
KUSTOMIZE_SHA256=763c4040ff01435bfce39661072452ebdf1cf2808bb91f5708ab4420834fbd42
ARGO_ROLLOUTS_SHA256=ad8da0c9f1e9a67292c0019a906ef7e54157d598df90fa0b59839bc039a624b7
GH_SHA256=98d0cfa794721665d7973dd728c78aff7bd836d58f10f6d7a03568eccb0a22e0

# Naming convention: FOO_SHA256 is the Windows build that
# scripts/install-tools.sh installs locally; FOO_SHA256_LINUX is what CI,
# which runs on ubuntu-24.04, verifies instead. Both come from the upstream
# release metadata, not from a re-download.

# Trivy is installed by CI only. ci.yml checks this repo out, sources this file
# and installs Trivy at exactly this version, so a tool version is declared once
# for the whole chain.
TRIVY_VERSION=v0.76.1
TRIVY_SHA256_LINUX=c7cbe3137fb8a48a17574bede3dd6beb16742d1e9772929940fc90082c39d9c0

# Cosign signs the image in CI and verifies it locally, so both halves of the
# supply chain use the same build. Both digests are GitHub's own (the release
# asset's `digest` field), not a re-download.
COSIGN_VERSION=v3.1.4
COSIGN_SHA256=cbe953787074611f1334cbf37dc1cf953995bb8c45398eb4fc7bb781d29c1f2a
COSIGN_SHA256_LINUX=424e2c97d0b45fd7a6b608a87f090f35633f4c23ece5f092d48bba11aaf4bbfa

# CI also needs kustomize, to rewrite the image tag in the overlay.
KUSTOMIZE_SHA256_LINUX=cb9e31198d3f63b44848bd0afc4c8efc56e6cfef9c93a4a39a211940e6decd61

# ---------------------------------------------------------------- app image --
# Tag plus digest: readable in logs, immutable in practice.
#
# A pin is a snapshot, so it goes stale before the tag does: this digest was
# Debian 12.15, and on 2026-11-07 CI's Trivy gate blocked a release on two
# fixable HIGHs inside it (CVE-2026-109518 in apt 2.6.1 being one). Rotating
# the digest -- never the tag alone -- is the fix, and it is a reviewable
# one-line change like everything else here.
PYTHON_BASE_IMAGE=python:3.12-slim-bookworm@sha256:935c3c5b12357a7e10caa9c1e6ca5692344d97cf229832ef584be2cec9fc03df

# ------------------------------------------------------------ infra: charts ---
# The two things in the cluster that arrive as Helm charts. A chart version
# pins every image tag inside it, so these lines are what fix the ingress
# controller and the whole prometheus-operator stack to a known build; the
# *_APP_VERSION lines are the images each chart resolves to, recorded so a
# reader can see them without unpacking the chart.
INGRESS_NGINX_CHART_VERSION=4.15.1
INGRESS_NGINX_APP_VERSION=1.15.1
KUBE_PROMETHEUS_STACK_CHART_VERSION=92.17.0
KUBE_PROMETHEUS_STACK_APP_VERSION=v0.94.2
# Kyverno is optional: only `bootstrap.sh --supply-chain` installs it. A chart
# version pins every image inside it, so this line is what fixes the admission
# controller to a known build; KYVERNO_APP_VERSION records what it resolves to.
#
# 3.9.2 and not 3.0.5: the chart's app version drives where cosign gets its
# trust root, and the 1.10 image still bootstraps keyless verification from the
# retired legacy TUF mirror (sigstore-tuf-root.storage.googleapis.com). That
# mirror now serves a timestamp whose key no longer validates, so an Enforce
# policy denies every Pod -- signed or not -- with "invalid key" in the webhook
# log. 1.19 ships the current Sigstore trust bundle.
KYVERNO_CHART_VERSION=3.9.2
KYVERNO_APP_VERSION=v1.19.2

# ------------------------------------------------- infra: raw manifests ------
# Argo CD and Argo Rollouts ship plain YAML, so bootstrap.sh downloads and
# verifies these before kubectl ever sees them.
#
# Argo Rollouts publishes install.yaml as a release asset and the GitHub API
# reports its digest, so the value below is upstream's own.
#
# Argo CD publishes no checksum: its manifests live in the git tree at the tag
# (raw.githubusercontent.com/argoproj/argo-cd/<tag>/manifests/install.yaml), so
# this sha256 is what that tag contained on the day it was pinned. The tag is
# the real anchor; the hash is here to turn a silent change into a loud one.
ARGO_ROLLOUTS_INSTALL_SHA256=149148429a6f8258b789003ffb9bc6698a526d611ecb1b185624217cf51bae7f
ARGOCD_INSTALL_SHA256=846c644bc81ce5557dd9048757a9c7353378f25c5eb811c77d32a9e907823599

# Every container image the cluster runs, written out instead of only implied by
# the chart and manifest pins above. bootstrap.sh pre-pulls this list on the
# Docker host and sideloads it into the kind node.
#
# These tags are what the pinned charts resolve today. If a chart version
# changes and a line here is left behind, nothing breaks: the node pulls the
# image the slow way and the pre-pull just stops covering it. Keep the ref
# exactly as kubelet will ask for it -- registry host included -- because the
# script matches on the full string.
INFRA_IMAGES="
  docker.io/grafana/grafana:13.3.0-distroless
  public.ecr.aws/docker/library/redis:8.2.3-alpine
  quay.io/argoproj/argo-rollouts:v1.10.1
  quay.io/argoproj/argocd:v3.5.6
  quay.io/kiwigrid/k8s-sidecar:2.14.1
  quay.io/prometheus-operator/prometheus-config-reloader:v0.94.2
  quay.io/prometheus-operator/prometheus-operator:v0.94.2
  quay.io/prometheus/prometheus:v3.15.1-distroless
  registry.k8s.io/kube-state-metrics/kube-state-metrics:v2.20.0
  ghcr.io/dexidp/dex:v2.45.1
"

# Pulled and sideloaded only by `bootstrap.sh --supply-chain`, kept out of
# INFRA_IMAGES so the default bootstrap does not pay for a component it is not
# installing. These are the containers the pinned chart actually runs: the init
# container that writes the webhook configuration, the admission webhook itself,
# and the `kyverno-cli` Job the chart registers as a post-upgrade hook. Nothing
# else in the chart is enabled -- the background, cleanup and reports controllers
# are switched off in bootstrap/helm/kyverno.yaml, as is the chart's own
# webhooksCleanup hook, whose image defaults to `latest`.
# (The chart also ships a `helm test` Pod; it only runs on `helm test`, never on
# install, so it is not in the list.)
#
# The third line is not decoration. `helm upgrade --install` means a first run is
# an install -- where the hook never fires -- and every re-run is an upgrade,
# where it does. Omit this image and the second `bootstrap.sh --supply-chain`
# hangs for the whole helm timeout inside a Pod stuck at ContainerCreating,
# because reg.kyverno.io is slow enough from a laptop that the pull the node has
# to do is the thing bootstrap.sh pre-pull exists to avoid.
SUPPLY_CHAIN_IMAGES="
  reg.kyverno.io/kyverno/kyvernopre:v1.19.2
  reg.kyverno.io/kyverno/kyverno:v1.19.2
  reg.kyverno.io/kyverno/kyverno-cli:v1.19.2
"
